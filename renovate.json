{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "etcd",
      "matchPackageNames": [
        "go.etcd.io/etcd/{/,}**"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "aws",
      "matchPackageNames": [
        "github.com/aws/{/,}**"
      ]
    },
    {
      "matchPackageNames": [
        "github.com/cloudflare/cloudflare-go"
      ],
      "enabled": false
    }
  ]
}
